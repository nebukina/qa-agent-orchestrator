{
  "mcp": {
    "servers": {
      "redmine": {
        "type": "local",
        "command": ["npx", "-y", "@speraltafibrazo/redmine-mcp"],
        "enabled": true,
        "environment": {
          "REDMINE_URL": "http://localhost:3000",
          "REDMINE_API_KEY": "{env:REDMINE_KEY}"
        }
      }
    }
  }
}