{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "redmine": {
        "type": "local",
        "command": ["node", ".opencode/redmine-mcp-launch.mjs"],
        "cwd": ".",
        "environment": {
          "REDMINE_URL": "http://localhost:3000"
        },
        "disabled": true
      }
    }
  },
  "permissions": [
    { "action": "redmine_read", "resource": "*", "effect": "allow" },
    { "action": "redmine_write", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/redmine/*", "effect": "allow" }
  ]
}